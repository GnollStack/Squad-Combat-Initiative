{{#if showPresets}}
<div class="form-group">
  <label>{{localize "SCI.Dialog.Preset"}}</label>
  <select id="g-preset" style="width: 100%;">
    <option value="">{{localize "SCI.Dialog.PresetNone"}}</option>
    {{#each presetOptions}}
    <option value="{{this.value}}">{{this.label}}</option>
    {{/each}}
  </select>
</div>
{{/if}}
<div class="form-group"{{#if showPresets}} style="margin-top: 10px;"{{/if}}>
  <label>{{localize "SCI.Dialog.Name"}}</label>
  <input id="g-name" type="text" value="{{name}}" autofocus>
</div>
<div class="form-group" style="display:flex; gap: 0.5em; align-items:center; margin-top: 5px;">
  <label style="flex:0 0 auto;">{{localize "SCI.Dialog.Icon"}}</label>
  <input id="g-img" type="text" style="flex:1" value="{{img}}" placeholder="icons/svg/skull.svg">
  <button type="button" id="g-img-picker" title="{{localize 'SCI.Browse'}}" style="flex:0 0 auto; width:30px;">
    <i class="fas fa-file-import"></i>
  </button>
</div>
<div class="form-group" style="margin-top: 5px;">
  <label>{{localize "SCI.Dialog.Color"}}</label>
  <input id="g-color" type="color" value="{{color}}" style="width:100%; height:30px; border:none;">
</div>
<div class="form-group" style="margin-top: 10px;">
  <label>{{localize "SCI.Dialog.InitiativeMode"}}</label>
  <select id="g-init-mode" style="width: 100%;">
    {{#each initModeOptions}}
    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
    {{/each}}
  </select>
</div>
{{#if showCaptain}}
<div class="form-group" style="margin-top: 5px;">
  <label>{{localize "SCI.Dialog.Captain"}}</label>
  <select id="g-captain" style="width: 100%;">
    {{#each captainOptions}}
    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
    {{/each}}
  </select>
</div>
{{/if}}
{{#if showHidden}}
<div class="form-group" style="margin-top: 10px;">
  <label style="display:flex; align-items:center; gap:5px;">
    <input id="g-hidden" type="checkbox">
    {{localize "SCI.Dialog.StartHidden"}}
  </label>
</div>
{{/if}}
{{#if showSavePreset}}
<div class="form-group" style="margin-top: 6px;">
  <label style="display:flex; align-items:center; gap:5px;">
    <input id="g-save-preset" type="checkbox">
    {{localize "SCI.Dialog.SaveAsPreset"}}
  </label>
</div>
{{/if}}
{{#if moraleEnabled}}
<div class="form-group" style="margin-top: 10px;">
  <label>{{localize "SCI.Dialog.MoraleTrigger"}}</label>
  <select id="g-morale-trigger" style="width: 100%;">
    {{#each moraleTriggerOptions}}
    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
    {{/each}}
  </select>
</div>
<div class="form-group" style="margin-top: 5px;">
  <label>{{localize "SCI.Dialog.Discipline"}}</label>
  <select id="g-discipline" style="width: 100%;">
    {{#each disciplineOptions}}
    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
    {{/each}}
  </select>
</div>
{{#if showMobDivisor}}
<div class="form-group" style="margin-top: 5px;">
  <label>{{localize "SCI.Dialog.MobDivisor"}}</label>
  <input id="g-mob-divisor" type="number" min="1" max="10" step="1" value="{{mobDivisor}}" style="width: 100%;">
  <p class="hint" style="font-size: 11px; opacity: 0.7; margin: 2px 0 0;">{{localize "SCI.Dialog.MobDivisorHint"}}</p>
</div>
{{/if}}
{{/if}}
